rules_version = '2';
// Reglas de seguridad de la base de datos de Edge 21 (Firestore). Se pegan en
// Firebase → Firestore Database → Reglas → Publicar. Ver CUENTA_GOOGLE.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // La fecha de un ranking (AAAA-MM-DD): tiene que ser cercana a hoy (el diario, de ayer a
    // mañana por las zonas horarias; el semanal, el lunes de esta semana). Así nadie llena la base
    // con rankings de fechas inventadas.
    function fechaOk(kind, key) {
      return key.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && math.abs(timestamp.date(int(key[0:4]), int(key[5:7]), int(key[8:10])).toMillis()
             - request.time.toMillis()) <= (kind == 'daily' ? 2 : 9) * 86400000;
    }

    // El progreso de cada persona: solo lo ve y lo cambia su dueño (comprimido, menos de 600 KB).
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['gz', 'text', 'updatedAt', 'version'])
        && (!('gz' in request.resource.data)
            || (request.resource.data.gz is bytes && request.resource.data.gz.size() <= 600000))
        && (!('text' in request.resource.data)
            || (request.resource.data.text is string && request.resource.data.text.size() <= 600000))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int)
        && (!('version' in request.resource.data)
            || (request.resource.data.version is string && request.resource.data.version.size() <= 20));
    }

    // Premium por cuenta: lo marca el dueño de la app desde la consola (o un pago en la web, más
    // adelante). Cada uno solo puede leer el suyo; desde la app nadie lo puede escribir.
    match /premium/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Ranking del desafío diario (daily/AAAA-MM-DD) y de la semana (weekly/AAAA-MM-DD del lunes).
    // Lo puede ver cualquiera; cada uno solo escribe su propio puntaje, con límites razonables.
    match /{kind}/{key}/scores/{uid} {
      allow read: if kind == 'daily' || kind == 'weekly';
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (kind == 'daily' || kind == 'weekly')
        && fechaOk(kind, key)
        && request.resource.data.keys().hasOnly(['name', 'score', 'ok', 't', 'expireAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= (kind == 'daily' ? 120 : 840)
        && (!('ok' in request.resource.data) || request.resource.data.ok is bool)
        && (!('t' in request.resource.data) || request.resource.data.t is int)
        && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt < request.time + duration.value(120, 'd')));
    }

    // Errores de la app: los guarda el servidor (con un límite por persona, para que nadie llene la
    // base). Desde la app nadie los puede leer ni escribir. Lo de abajo queda para versiones viejas
    // de la app que todavía los mandan directo; se puede pasar a "if false" cuando ya no haya.
    match /errores/{id} {
      allow create: if request.resource.data.keys().hasOnly(['msg', 'stack', 'where', 'version', 'plataforma', 'idioma', 't', 'expireAt'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.where is string && request.resource.data.where.size() <= 200
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.plataforma in ['android', 'web']
        && request.resource.data.idioma is string && request.resource.data.idioma.size() <= 10
        && request.resource.data.t is int
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt < request.time + duration.value(120, 'd');
    }
  }
}
