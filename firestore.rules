rules_version = '2';
// Reglas de seguridad de la base de datos de Edge 21 (Firestore). Se pegan en
// Firebase → Firestore Database → Reglas → Publicar. Ver CUENTA_GOOGLE.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // El progreso de cada persona: solo lo ve y lo cambia su dueño.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['gz', 'text', 'updatedAt', 'version']);
    }

    // Premium por cuenta: lo marca el dueño de la app desde la consola (o un pago en la web, más
    // adelante). Cada uno solo puede leer el suyo; desde la app nadie lo puede escribir.
    match /premium/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Ranking del desafío diario (daily/AAAA-MM-DD) y de la semana (weekly/AAAA-MM-DD del lunes).
    // Lo puede ver cualquiera; cada uno solo escribe su propio puntaje, con límites razonables.
    match /{kind}/{key}/scores/{uid} {
      allow read: if kind == 'daily' || kind == 'weekly';
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (kind == 'daily' || kind == 'weekly')
        && request.resource.data.keys().hasOnly(['name', 'score', 'ok', 't', 'expireAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= (kind == 'daily' ? 120 : 840)
        && (!('ok' in request.resource.data) || request.resource.data.ok is bool)
        && (!('t' in request.resource.data) || request.resource.data.t is int)
        && (!('expireAt' in request.resource.data)
            || (request.resource.data.expireAt is timestamp
                && request.resource.data.expireAt < request.time + duration.value(120, 'd')));
    }

    // Errores de la app: se pueden mandar, pero nadie los puede leer desde la app.
    match /errores/{id} {
      allow create: if request.resource.data.keys().hasOnly(['msg', 'stack', 'where', 'version', 'plataforma', 'idioma', 't', 'expireAt'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.where is string && request.resource.data.where.size() <= 200
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.plataforma in ['android', 'web']
        && request.resource.data.idioma is string && request.resource.data.idioma.size() <= 10
        && request.resource.data.t is int
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt < request.time + duration.value(120, 'd');
    }
  }
}
